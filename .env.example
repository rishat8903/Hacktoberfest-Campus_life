# Port for the unified fullstack server
PORT=3000

# Google AI Studio API key (Required for Gemma 3.8 / Gemma 4 multimodal and language processing)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# ElevenLabs API key (Optional: provides ultra-realistic voice for study notes & campus bus navigator)
# If left blank, the app gracefully falls back to browser-native speech synthesis
ELEVENLABS_API_KEY=""

# Optional ElevenLabs Voice ID (Defaults to a warm educational voice)
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
